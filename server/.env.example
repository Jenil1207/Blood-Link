PORT=5000
NODE_ENV=development
# Atlas (recommended) or a local MongoDB replica set. Never commit real credentials.
MONGO_URI=mongodb://127.0.0.1:27017/bloodlink?replicaSet=rs0
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave at 0 locally. Set to 1 for the direct Render web-service deployment.
TRUST_PROXY_HOPS=0
TOKEN_HOURS=8
# Lab scheduling interval, not a clinical eligibility policy.
DONATION_INTERVAL_DAYS=90
# Used only by npm run create-admin. Set these before running it.
ADMIN_NAME=BloodLink Admin
ADMIN_EMAIL=admin@bloodlink.local
ADMIN_PASSWORD=
# Used only by npm run seed. Choose a password (minimum 8 characters).
DEMO_PASSWORD=
