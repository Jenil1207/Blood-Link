{
  "name": "bloodlink-server",
  "version": "1.0.0",
  "description": "Backend API for BloodLink blood donation & hospital SOS coordination platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "test": "node --test --test-concurrency=1",
    "test:watch": "node --test --watch --test-concurrency=1",
    "create-admin": "node scripts/create-admin.js",
    "docs": "node scripts/generate-openapi.js"
  },
  "keywords": [
    "mern",
    "blood-donation",
    "hospital-management",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
